{
  "manifest_version": 1,
  "type": "device",
  "name": "Notifications Android/Fire TV",
  "description": {
    "en": "Show notifications on your Android TV or Fire TV: messages, doorbell camera pictures, alerts.",
    "fr": "Affichez des notifications sur votre Android TV ou Fire TV : messages, photo de la sonnette…",
    "de": "Zeig Benachrichtigungen auf deinem Android TV oder Fire TV: Nachrichten, Türklingel-Bilder…",
    "es": "Muestre notificaciones en su Android TV o Fire TV: mensajes, foto del timbre, alertas."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-tv-notify:1.0.1",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-tv-notify/main/cover.png",
  "categories": ["notifications", "multimedia"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your TVs",
        "fr": "Vos TV",
        "de": "Deine Fernseher",
        "es": "Sus televisores"
      },
      "description": {
        "en": "Install a notification app on each TV (\"Notifications for Android TV\" or \"for Fire TV\", PiPup, TvOverlay) and open it once: it shows the address of the TV. Then add the TV with \"Add or update a TV\" below and create its device in the Discover tab.",
        "fr": "Installez une appli de notifications sur chaque TV (« Notifications for Android TV » ou « for Fire TV », PiPup, TvOverlay) et ouvrez-la une fois : elle affiche l'adresse de la TV. Ajoutez la TV avec « Ajouter ou modifier une TV » et créez son appareil dans l'onglet Découverte.",
        "de": "Installiere auf jedem Fernseher eine Benachrichtigungs-App („Notifications for Android TV“ oder „for Fire TV“, PiPup, TvOverlay) und öffne sie einmal: Die App zeigt die Adresse an. Füge den Fernseher mit „Fernseher hinzufügen oder ändern“ hinzu und lege sein Gerät unter „Entdecken“ an.",
        "es": "Instale una aplicación de notificaciones en cada televisor («Notifications for Android TV» o «for Fire TV», PiPup, TvOverlay) y ábrala una vez: muestra la dirección del televisor. Añádalo con «Añadir o modificar un televisor» y cree su dispositivo en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://play.google.com/store/apps/details?id=de.cyberdream.androidtv.notifications.google",
          "label": {
            "en": "Notifications for Android TV (Google Play)",
            "fr": "Notifications for Android TV (Google Play)",
            "de": "Notifications for Android TV (Google Play)",
            "es": "Notifications for Android TV (Google Play)"
          }
        },
        {
          "url": "https://www.amazon.com/dp/B00OESCXEK",
          "label": {
            "en": "Notifications for Fire TV (Amazon Appstore)",
            "fr": "Notifications for Fire TV (Amazon Appstore)",
            "de": "Notifications for Fire TV (Amazon Appstore)",
            "es": "Notifications for Fire TV (Amazon Appstore)"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language",
        "fr": "Langue",
        "de": "Sprache",
        "es": "Idioma"
      },
      "description": {
        "en": "Language of the feature names, of the action messages and of the test notification.",
        "fr": "Langue des noms de fonctionnalités, des messages des actions et de la notification de test.",
        "de": "Sprache der Funktionsnamen, der Meldungen der Aktionen und der Testbenachrichtigung.",
        "es": "Idioma de los nombres de las funciones, de los mensajes de las acciones y de la notificación de prueba."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "English",
            "de": "English",
            "es": "English"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "Français",
            "fr": "Français",
            "de": "Français",
            "es": "Français"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "Deutsch",
            "fr": "Deutsch",
            "de": "Deutsch",
            "es": "Deutsch"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Español",
            "fr": "Español",
            "de": "Español",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "check_interval",
      "type": "select",
      "label": {
        "en": "Check the TVs every",
        "fr": "Tester les TV toutes les",
        "de": "Fernseher prüfen alle",
        "es": "Comprobar los televisores cada"
      },
      "description": {
        "en": "One connection to the notification app of each TV: nothing appears on the screen.",
        "fr": "Une connexion à l'appli de notifications de chaque TV : rien ne s'affiche à l'écran.",
        "de": "Eine Verbindung zur Benachrichtigungs-App jedes Fernsehers: Auf dem Bildschirm erscheint nichts.",
        "es": "Una conexión a la aplicación de notificaciones de cada televisor: no aparece nada en la pantalla."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "15",
          "label": {
            "en": "15 seconds",
            "fr": "15 secondes",
            "de": "15 Sekunden",
            "es": "15 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        }
      ]
    },
    {
      "key": "offline_after",
      "type": "select",
      "label": {
        "en": "Unreachable after",
        "fr": "Injoignable après",
        "de": "Nicht erreichbar nach",
        "es": "Inaccesible tras"
      },
      "description": {
        "en": "Time without any answer before a TV is shown as unreachable. A TV on Wi-Fi sometimes misses one check.",
        "fr": "Durée sans aucune réponse avant qu'une TV soit indiquée injoignable. Une TV en Wi-Fi rate parfois un test.",
        "de": "Zeit ohne Antwort, bevor ein Fernseher als nicht erreichbar gilt. Ein Fernseher im WLAN verpasst manchmal eine Prüfung.",
        "es": "Tiempo sin respuesta antes de indicar un televisor como inaccesible. Un televisor en Wi-Fi a veces pierde una comprobación."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "0",
          "label": {
            "en": "At the first failed check",
            "fr": "Au premier test sans réponse",
            "de": "Bei der ersten Prüfung ohne Antwort",
            "es": "En la primera comprobación sin respuesta"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "add_tv",
      "label": {
        "en": "Add or update a TV",
        "fr": "Ajouter ou modifier une TV",
        "de": "Fernseher hinzufügen oder ändern",
        "es": "Añadir o modificar un televisor"
      },
      "description": {
        "en": "Adds a TV, or updates the TV with the same name or address, then checks that its app answers.",
        "fr": "Ajoute une TV, ou met à jour celle de même nom ou de même adresse, puis vérifie que son appli répond.",
        "de": "Fügt einen Fernseher hinzu oder aktualisiert den mit gleichem Namen oder gleicher Adresse und prüft dann, ob seine App antwortet.",
        "es": "Añade un televisor, o actualiza el que tiene el mismo nombre o la misma dirección, y comprueba que su aplicación responde."
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "label": {
            "en": "Name",
            "fr": "Nom",
            "de": "Name",
            "es": "Nombre"
          },
          "placeholder": {
            "en": "e.g. Living room TV",
            "fr": "ex. TV du salon",
            "de": "z. B. Wohnzimmer-TV",
            "es": "p. ej. Televisor del salón"
          }
        },
        {
          "key": "address",
          "type": "string",
          "required": true,
          "label": {
            "en": "IP address of the TV",
            "fr": "Adresse IP de la TV",
            "de": "IP-Adresse des Fernsehers",
            "es": "Dirección IP del televisor"
          },
          "description": {
            "en": "Shown by the app when you open it on the TV. A fixed address works best (DHCP reservation in your router).",
            "fr": "Affichée par l'appli quand vous l'ouvrez sur la TV. Une adresse fixe est préférable (réservation DHCP dans votre box).",
            "de": "Wird von der App angezeigt, wenn du sie auf dem Fernseher öffnest. Eine feste Adresse ist am besten (DHCP-Reservierung im Router).",
            "es": "La muestra la aplicación cuando la abre en el televisor. Es mejor una dirección fija (reserva DHCP en su router)."
          },
          "placeholder": {
            "en": "e.g. 192.168.1.30",
            "fr": "ex. 192.168.1.30",
            "de": "z. B. 192.168.1.30",
            "es": "p. ej. 192.168.1.30"
          }
        },
        {
          "key": "app",
          "type": "select",
          "required": true,
          "label": {
            "en": "App installed on the TV",
            "fr": "Appli installée sur la TV",
            "de": "Auf dem Fernseher installierte App",
            "es": "Aplicación instalada en el televisor"
          },
          "options": [
            {
              "value": "nfandroidtv",
              "label": {
                "en": "Notifications for Android TV / Fire TV",
                "fr": "Notifications for Android TV / Fire TV",
                "de": "Notifications for Android TV / Fire TV",
                "es": "Notifications for Android TV / Fire TV"
              }
            },
            {
              "value": "pipup",
              "label": {
                "en": "PiPup",
                "fr": "PiPup",
                "de": "PiPup",
                "es": "PiPup"
              }
            },
            {
              "value": "tvoverlay",
              "label": {
                "en": "TvOverlay",
                "fr": "TvOverlay",
                "de": "TvOverlay",
                "es": "TvOverlay"
              }
            }
          ]
        },
        {
          "key": "port",
          "type": "number",
          "required": false,
          "min": 1,
          "max": 65535,
          "label": {
            "en": "Port (optional)",
            "fr": "Port (facultatif)",
            "de": "Port (optional)",
            "es": "Puerto (opcional)"
          },
          "description": {
            "en": "Empty: the port of the app (7676, PiPup 7979, TvOverlay 5001).",
            "fr": "Vide : le port de l'appli (7676, PiPup 7979, TvOverlay 5001).",
            "de": "Leer: der Port der App (7676, PiPup 7979, TvOverlay 5001).",
            "es": "Vacío: el puerto de la aplicación (7676, PiPup 7979, TvOverlay 5001)."
          }
        }
      ]
    },
    {
      "key": "remove_tv",
      "label": {
        "en": "Remove a TV",
        "fr": "Retirer une TV",
        "de": "Fernseher entfernen",
        "es": "Eliminar un televisor"
      },
      "description": {
        "en": "Stops checking the TV. Delete its device in Gladys as well if you no longer need it.",
        "fr": "Arrête de tester la TV. Supprimez aussi son appareil dans Gladys s'il ne sert plus.",
        "de": "Beendet die Prüfung des Fernsehers. Lösche auch sein Gerät in Gladys, wenn du es nicht mehr brauchst.",
        "es": "Deja de comprobar el televisor. Elimine también su dispositivo en Gladys si ya no lo necesita."
      },
      "fields": [
        {
          "key": "tv",
          "type": "string",
          "required": true,
          "label": {
            "en": "Name or address of the TV",
            "fr": "Nom ou adresse de la TV",
            "de": "Name oder Adresse des Fernsehers",
            "es": "Nombre o dirección del televisor"
          }
        }
      ]
    },
    {
      "key": "test_notification",
      "label": {
        "en": "Send a test notification",
        "fr": "Envoyer une notification de test",
        "de": "Testbenachrichtigung senden",
        "es": "Enviar una notificación de prueba"
      },
      "description": {
        "en": "Shows a short message on the chosen TV, to check that everything works.",
        "fr": "Affiche un court message sur la TV choisie, pour vérifier que tout fonctionne.",
        "de": "Zeigt eine kurze Nachricht auf dem gewählten Fernseher, um zu prüfen, ob alles funktioniert.",
        "es": "Muestra un mensaje corto en el televisor elegido, para comprobar que todo funciona."
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
            "en": "TV",
            "fr": "TV",
            "de": "Fernseher",
            "es": "Televisor"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "show_notification",
      "label": {
        "en": "Show a notification on the TV",
        "fr": "Afficher une notification sur la TV",
        "de": "Benachrichtigung auf dem Fernseher anzeigen",
        "es": "Mostrar una notificación en el televisor"
      },
      "description": {
        "en": "A message over what the TV is showing, with an optional picture (a camera snapshot). If the TV is off, \"Notification shown\" is 0.",
        "fr": "Un message par-dessus ce qu'affiche la TV, avec une image facultative (photo d'une caméra). Si la TV est éteinte, « Notification affichée » vaut 0.",
        "de": "Eine Nachricht über dem Fernsehbild, mit optionalem Bild (Kamera-Schnappschuss). Ist der Fernseher aus, ist „Benachrichtigung angezeigt“ 0.",
        "es": "Un mensaje sobre lo que muestra el televisor, con una imagen opcional (foto de una cámara). Si el televisor está apagado, «Notificación mostrada» vale 0."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
